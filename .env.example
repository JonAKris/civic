# --- Postgres on msa1 (writer role; leave PG_PASSWORD blank to use ~/.pgpass) ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=civic
PG_USER=jon
PG_PASSWORD=

# --- API keys ---
# One free key from https://api.data.gov/signup/ works for both of these:
CONGRESS_API_KEY=
FEC_API_KEY=
# Free key from https://open.pluralpolicy.com/accounts/profile/ (Open States v3)
OPENSTATES_API_KEY=

# --- Scope ---
CONGRESS=119
TIGER_YEAR=2024          # state legislative maps
CD_TIGER_YEAR=2025       # congressional maps (119th Congress first published in TIGER2025)
# Comma list (IL,WI,IN) or ALL for all 50 states
STATES=IL

# --- Open States throttling (free tier is small; raise if Plural grants more) ---
OPENSTATES_MAX_REQUESTS=450
OPENSTATES_MIN_INTERVAL=6.5

DATA_DIR=./data
